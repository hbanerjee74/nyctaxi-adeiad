{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accelerate-data/sample-nyctaxi-comp/logical-model/vibedata-schema.json",
  "title": "VIBEDATA extensions for Apache Ossie (frozen key set)",
  "description": "The closed VIBEDATA payload vocabulary. Each custom_extensions entry with vendor_name VIBEDATA carries a JSON-encoded object of one of these four shapes, chosen by the level it sits at. Unknown keys are rejected by tools/ossie.py; new keys arrive by intent with a validator change and tests.",
  "type": "object",
  "$defs": {
    "modelPayload": {
      "type": "object",
      "properties": {
        "vibedata_version": {
          "type": "string"
        },
        "physical_tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/physicalTable"
          }
        },
        "physical_joins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/physicalJoin"
          }
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variable"
          }
        }
      },
      "additionalProperties": false
    },
    "physicalTable": {
      "type": "object",
      "required": [
        "name",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "dbt_model": {
          "type": "string",
          "description": "dbt ref() name that builds this table; aliases name their base model"
        },
        "table_type": {
          "enum": [
            "TABLE",
            "VIEW",
            "ALIAS",
            "OPAQUE_VIEW",
            "STORED_PROC",
            "SYNONYM"
          ]
        },
        "alias_of": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "note": {
          "type": "string",
          "description": "Why-not or partial-mapping rationale, recorded where it cannot drift from the entry"
        }
      },
      "additionalProperties": false
    },
    "physicalJoin": {
      "type": "object",
      "required": [
        "name",
        "from",
        "to"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "datasetPayload": {
      "type": "object",
      "properties": {
        "vibedata_version": {
          "type": "string"
        },
        "alias_of": {
          "type": "string"
        },
        "physical": {
          "type": "object"
        },
        "partitioned_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scd": {
          "$ref": "#/$defs/scd"
        },
        "logical_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/logicalSource"
          }
        },
        "hierarchies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hierarchy"
          }
        }
      },
      "additionalProperties": false
    },
    "scd": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            1,
            2,
            3
          ]
        },
        "natural_key": {
          "type": "string"
        },
        "valid_from": {
          "type": "string"
        },
        "valid_to": {
          "type": "string"
        },
        "is_current": {
          "type": "string"
        },
        "open_ended_value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "logicalSource": {
      "type": "object",
      "required": [
        "name",
        "physical_table"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "physical_table": {
          "type": "string",
          "minLength": 1
        },
        "priority_group": {
          "type": "integer",
          "minimum": 0
        },
        "content_grain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string",
          "description": "Partial-mapping rationale: which columns were refused and why"
        },
        "column_map": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "join_cost": {
          "type": "number",
          "description": "Relative cost for aggregate ordering, lower wins"
        },
        "content_levels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/levelRef"
          },
          "description": "Per dimension role, the level this source holds; a role not listed is aggregated away"
        },
        "content_filter": {
          "type": "string",
          "minLength": 1,
          "description": "Row predicate over the dataset's fields and :variables that every row of this source satisfies; held by a test named in note"
        },
        "navigable": {
          "type": "boolean",
          "description": "false: an engine must not choose this source unless asked by name (population the content_filter cannot state)"
        }
      },
      "additionalProperties": false
    },
    "hierarchy": {
      "type": "object",
      "required": [
        "name",
        "levels"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "is_time": {
          "type": "boolean",
          "description": "Levels order chronologically, so time-series metrics may shift along them"
        },
        "levels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/level"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "relationshipPayload": {
      "type": "object",
      "properties": {
        "vibedata_version": {
          "type": "string"
        },
        "physical_join": {
          "type": "string"
        },
        "cardinality": {
          "enum": [
            "many-to-one",
            "one-to-one",
            "many-to-many"
          ]
        },
        "join_type": {
          "type": "string"
        },
        "join_cost": {
          "type": "number"
        },
        "join_expression": {
          "type": "string"
        },
        "note": {
          "type": "string",
          "description": "Why this relationship lacks key-covering to_columns, or why a reachable path has none"
        }
      },
      "additionalProperties": false
    },
    "variable": {
      "type": "object",
      "required": [
        "name"
      ],
      "description": "A named value predicates reference as :name, bound to where the repo defines it (OBIEE repository variable)",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "datatype": {
          "type": "string",
          "description": "Ossie DataType of the value"
        },
        "dbt_var": {
          "type": "string",
          "description": "dbt project var that supplies the value"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "level": {
      "type": "object",
      "required": [
        "name",
        "key"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Fields that identify one member of the level"
        },
        "label": {
          "type": "string",
          "description": "Field shown for a member when the key is not readable"
        }
      },
      "additionalProperties": false
    },
    "levelRef": {
      "type": "object",
      "required": [
        "via"
      ],
      "properties": {
        "via": {
          "type": "string",
          "description": "Relationship that reaches the dimension (names the role)"
        },
        "hierarchy": {
          "type": "string"
        },
        "level": {
          "type": "string",
          "description": "Omitted with hierarchy: the target's own key level"
        }
      },
      "additionalProperties": false
    },
    "metricPayload": {
      "type": "object",
      "properties": {
        "vibedata_version": {
          "type": "string"
        },
        "aggregation": {
          "enum": [
            "SUM",
            "MIN",
            "MAX",
            "NON_ADDITIVE"
          ],
          "description": "Rule for rolling a pre-aggregated column up to a coarser grain; NON_ADDITIVE never rolls up"
        },
        "derived_expression": {
          "type": "string",
          "description": "Post-aggregation formula over other metrics; the metric binds to no column"
        },
        "at_levels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/levelRef"
          },
          "description": "Level-based metric: evaluated at these levels whatever the query groups by"
        },
        "time_series": {
          "$ref": "#/$defs/timeSeries"
        }
      },
      "additionalProperties": false
    },
    "timeSeries": {
      "type": "object",
      "required": [
        "function",
        "of",
        "via",
        "hierarchy",
        "level"
      ],
      "properties": {
        "function": {
          "enum": [
            "AGO",
            "TODATE"
          ]
        },
        "of": {
          "type": "string",
          "description": "Metric whose value is shifted or accumulated"
        },
        "via": {
          "type": "string"
        },
        "hierarchy": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 1,
          "description": "AGO only: periods back"
        }
      },
      "additionalProperties": false
    }
  }
}
